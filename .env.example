# Copy to .env or export these in your shell before --live-integrations.
# Do not commit real tokens.

# HubSpot private app token with crm.objects.deals.write.
HUBSPOT_ACCESS_TOKEN=

# Required for idempotent deal upserts. Create this as a unique deal property
# in HubSpot before using --live-integrations.
HUBSPOT_DEAL_EXTERNAL_ID_PROPERTY=gtm_router_deal_id

# Defaults match a typical HubSpot default sales pipeline; override for your portal.
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled

# Optional: lets dashboard/event receipts link to the created deal.
HUBSPOT_PORTAL_ID=

# Slack bot token with chat:write and a target channel ID, e.g. C0123456789.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
