# Copy to .env or export these in your shell before --live-integrations.
# Do not commit real tokens.

# HubSpot private app token with crm.objects.deals.write/read.
HUBSPOT_ACCESS_TOKEN=

# Required for idempotent deal upserts. Create this as a unique deal property
# in HubSpot before using --live-integrations.
HUBSPOT_DEAL_EXTERNAL_ID_PROPERTY=gtm_router_deal_id

# Defaults match a typical HubSpot default sales pipeline; override for your portal.
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled

# Optional: lets dashboard/event receipts link to the created deal.
HUBSPOT_PORTAL_ID=

# Required for live mode: validate POST /webhooks/hubspot with HubSpot's v3 signature.
HUBSPOT_WEBHOOK_SECRET=

# Public HTTPS origin HubSpot calls, e.g. https://router.example.com.
# Prefer this over trusting forwarded headers when deployed behind a proxy.
PUBLIC_BASE_URL=
TRUST_PROXY=0

# Local-only escape hatch for unsigned dry-run webhook curl tests.
ALLOW_UNSIGNED_WEBHOOKS=0

# Required in live mode: comma-separated dealstage IDs to notify on. Dry-run
# may leave this empty to notify every router-owned stage change.
HUBSPOT_NOTIFY_STAGE_IDS=

# Slack bot token with chat:write and a target channel ID, e.g. C0123456789.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
